AZURE_OPENAI_ENDPOINT="https://<your-resource>.openai.azure.com/"
OPENAI_API_VERSION="2025-01-01-preview"
AZURE_OPENAI_API_KEY="<set in Azure App Service settings or a local .env, never commit>"
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-5.5"
PORT=3001

# Companies House API key — powers the live company/officer/PSC lookups on the
# caseworker ownership tab. Without it that widget falls back to demo data.
CompanySearch="<your-companies-house-api-key>"

# Optional — leave unset for local dev. See docs/DEPLOYMENT.md.
# ALLOWED_ORIGINS=https://your-app.azurestaticapps.net
# REQUIRE_SWA_AUTH=false
# RATE_LIMIT_WINDOW_MS=300000
# RATE_LIMIT_MAX=30
# AZURE_OPENAI_SUPPORTS_TEMPERATURE=false
# AZURE_OPENAI_REASONING_ALLOWANCE=4000
# RATE_LIMIT_GLOBAL_MAX=120
